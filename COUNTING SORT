import java.util.Arrays;

public class CountingSort {

    public static void countingSort(int[] arr) {

        int n = arr.length;

        // Find maximum element
        int max = arr[0];

        for (int i = 0; i < n; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }

        // Count array
        int[] count = new int[max];

        // 1. Count frequency
        for (int i = 0; i < n; i++) {
            count[arr[i] - 1]++;
        }

        // 2. Prefix Sum
        for (int i = 1; i < count.length; i++) {
            count[i] = count[i] + count[i - 1];
        }

        // 3. Create answer array
        int[] ans = new int[n];

        // 4. Place elements
        for (int i = 0; i < n; i++) {
            ans[count[arr[i] - 1] - 1] = arr[i];
            count[arr[i] - 1]--;
        }

        // 5. Copy answer back to original array
        System.arraycopy(ans, 0, arr, 0, n);
    }

    public static void main(String[] args) {

        int[] arr = {4, 2, 2, 8, 3, 3, 1};

        countingSort(arr);

        System.out.println(Arrays.toString(arr));
    }
}

Output:

[1, 2, 2, 3, 3, 4, 8]

The main pattern you're remembering is:

Count
  ↓
Prefix Sum
  ↓
ans[count[arr[i] - 1] - 1] = arr[i]
  ↓
count[arr[i] - 1]--

⚠️ This version assumes the array contains positive integers ("1, 2, 3...").
